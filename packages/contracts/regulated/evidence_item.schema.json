{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_item.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "record_id",
    "authority",
    "effective_at",
    "retrieved_at",
    "facts",
    "integrity"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "object"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "source_preserved"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_preserved": {
          "const": true
        }
      }
    }
  }
}